# Copy this file to ".env" and fill in your real values.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# "From" address shown on every notification email.
# Use the shared Resend test sender until you verify your own domain.
NOTIFICATION_FROM=Store Notifications <onboarding@resend.dev>

# Required for customer authentication in production.
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
